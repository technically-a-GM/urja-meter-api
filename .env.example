# sample = fictional data; live = actual verified portal read-only endpoints.
DATA_SOURCE=sample
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
#  Snapshot: signed read-only refresh on demand with `python -m scripts.refresh_export` using a valid session.
# Alternatively place the authorized downloaded export JSON here.
METER_EXPORT_PATH=data/meter-export.json
# recommended: login  credentials for authorized operator account.
#  The client POSTs form data to /login and stores the reslting session in memory.
# Never commit .env or share screenshots containing these values.
PORTAL_EMAIL=
PORTAL_PASSWORD=
# Optional alternative: manually provided browser session. If email/password
# are set, the client will renew this session after an upstream 401.
PORTAL_SESSION_COOKIE=
# The portals timezone is not stated in the JSON. Assumed Asia/Kolkata.
PORTAL_TIMEZONE=Asia/Kolkata
UPSTREAM_TIMEOUT_SECONDS=15
